VITE_SERVER_URL=http://localhost:3001
# VGames Identity worker (accounts/auth). Defaults to the live viota worker
# if unset — see src/auth/vgamesClient.ts.
VITE_VGAMES_URL=https://viota-worker.theonenonlyvj.workers.dev
# Server-side counterpart of VITE_VGAMES_URL — used by server/index.ts to
# verify JWTs via POST /auth/introspect (see server/vgamesAuth.ts). Defaults
# to the same live viota worker if unset.
VGAMES_URL=https://viota-worker.theonenonlyvj.workers.dev
