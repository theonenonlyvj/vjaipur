VITE_SERVER_URL=http://localhost:3001
# vjaipur-worker (Phase 2C online play — server-authoritative Cloudflare
# Worker). Defaults to a local `wrangler dev` at :8787 if unset — see
# src/net/http.ts. Live: https://vjaipur-worker.theonenonlyvj.workers.dev
VITE_VJAIPUR_WORKER_URL=http://localhost:8787
# VGames Identity worker (accounts/auth). Defaults to the live viota worker
# if unset — see src/auth/vgamesClient.ts.
VITE_VGAMES_URL=https://vgames-identity.theonenonlyvj.workers.dev
# Server-side counterpart of VITE_VGAMES_URL — used by server/index.ts to
# verify JWTs via POST /auth/introspect (see server/vgamesAuth.ts). Defaults
# to the same live viota worker if unset.
VGAMES_URL=https://vgames-identity.theonenonlyvj.workers.dev

# ---- server/ (the HELD legacy Socket.IO backend — superseded for online
# play by the Cloudflare Worker above, but still present; do not delete) ----
# Allowed browser origin for CORS on the Socket.IO server. Defaults to '*' if unset.
CLIENT_ORIGIN=http://localhost:5173
# Port server/index.ts listens on. Defaults to 3001 if unset.
PORT=3001
# Supabase project URL — server/db.ts (legacy account/leaderboard storage).
SUPABASE_URL=
# Server-only Supabase service role key — NEVER expose to the client or
# screenshots; rotate immediately if it is ever shown.
SUPABASE_SERVICE_ROLE_KEY=
